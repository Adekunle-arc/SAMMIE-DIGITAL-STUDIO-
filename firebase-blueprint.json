{
  "entities": {
    "PortfolioItem": {
      "title": "PortfolioItem",
      "description": "A creative studio work or portfolio piece added by the studio admin.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string" },
        "description": { "type": "string", "maxLength": 1500 },
        "image": { "type": "string" },
        "images": { "type": "array" },
        "aspectRatio": { "type": "string" },
        "buttonText": { "type": "string", "maxLength": 50 },
        "externalUrl": { "type": "string" },
        "link": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "order": { "type": "number" },
        "authorId": { "type": "string" }
      },
      "required": ["title", "category", "image"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Studio administrators allowed to manage portfolio works.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "StudioSettings": {
      "title": "StudioSettings",
      "description": "Studio configuration settings including SEO verification and CEO/Founder profile picture and information.",
      "type": "object",
      "properties": {
        "googleSiteVerification": { "type": "string" },
        "ceoPhotoUrl": { "type": "string" },
        "ceoName": { "type": "string", "maxLength": 120 },
        "ceoTitle": { "type": "string", "maxLength": 150 },
        "ceoQuote": { "type": "string", "maxLength": 1000 },
        "ceoPhone": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/portfolio/{portfolioId}": {
      "schema": "PortfolioItem",
      "description": "Publicly readable portfolio works managed by studio administrator."
    },
    "/settings/{settingId}": {
      "schema": "StudioSettings",
      "description": "Studio settings including Google Search Console verification token."
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Admin users permitted to modify portfolio works."
    }
  }
}
