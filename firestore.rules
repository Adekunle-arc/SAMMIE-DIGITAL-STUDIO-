rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidPortfolioItem(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.category is string && data.category.size() > 0 && data.category.size() <= 60
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 3000))
        && data.image is string && data.image.size() > 0
        && (!('images' in data) || (data.images is list && data.images.size() <= 10))
        && (!('link' in data) || data.link == null || (data.link is string && data.link.size() <= 1000))
        && (!('externalUrl' in data) || data.externalUrl == null || (data.externalUrl is string && data.externalUrl.size() <= 1000))
        && (!('authorId' in data) || data.authorId == null || data.authorId is string)
        && (!('order' in data) || data.order is number)
        && (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is string || data.updatedAt is timestamp);
    }

    function isStudioAdmin() {
      return request.auth != null && request.auth.token.email == 'samadeniran15@gmail.com';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Portfolio items: Public read, writes authorized with valid data structure
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow create: if isValidId(portfolioId) && isValidPortfolioItem(incoming());
      allow update: if isValidId(portfolioId) && isValidPortfolioItem(incoming());
      allow delete: if isValidId(portfolioId);
    }

    // Studio settings (SEO, Google Search Console verification token)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
